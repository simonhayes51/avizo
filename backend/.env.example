# Database Configuration
# For local development, leave this commented out to use SQLite
# For production (Railway, etc), set this to your PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Configuration
# CRITICAL: Change this to a strong, random secret key in production
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-in-production

# CORS Configuration
# Comma-separated list of allowed origins
# For local development:
# ALLOWED_ORIGINS=http://localhost:5173
# For production, add your frontend domain:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173
